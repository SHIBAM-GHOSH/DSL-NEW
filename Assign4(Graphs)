#include <bits/stdc++.h>
using namespace std;

class Graph {
public:
    int V;  // Number of vertices
    vector<vector<int>> adj;  // Adjacency matrix

    // Constructor to initialize the graph
    Graph(int V) {
        this->V = V;
        adj.resize(V, vector<int>(V, 0));  // Initialize V x V matrix with 0's
    }

    // Add edge to the graph (undirected edge between i and j)
    void addEdge(int i, int j) {
        adj[i][j] = 1;  // Edge from i to j
        adj[j][i] = 1;  // Edge from j to i (making it undirected)
    }

    // Function to display the adjacency matrix
    void displayMatrix() {
        cout << "Adjacency Matrix: " << endl;
        for (int i = 0; i < V; i++) {
            for (int j = 0; j < V; j++) {
                cout << adj[i][j] << " ";
            }
            cout << endl;
        }
    }

    // Recursive DFS
    void DFSRecursive(int start, vector<bool>& visited) {
        visited[start] = true;
        cout << start << " ";

        for (int i = 0; i < V; i++) {
            // Check for an edge from start to vertex i
            if (adj[start][i] == 1 && !visited[i]) {
                DFSRecursive(i, visited);
            }
        }
    }

    // Iterative DFS using stack
    void DFSIterative(int start) {
        vector<bool> visited(V, false);
        stack<int> s;
        s.push(start);
        visited[start] = true;

        while (!s.empty()) {
            int node = s.top();
            s.pop();
            cout << node << " ";

            for (int i = 0; i < V; i++) {
                // Check for an edge from node to vertex i
                if (adj[node][i] == 1 && !visited[i]) {
                    s.push(i);
                    visited[i] = true;
                }
            }
        }
    }

    // Iterative BFS using queue
    void BFSIterative(int start) {
        vector<bool> visited(V, false);
        queue<int> q;
        q.push(start);
        visited[start] = true;

        while (!q.empty()) {
            int node = q.front();
            q.pop();
            cout << node << " ";

            for (int i = 0; i < V; i++) {
                // Check for an edge from node to vertex i
                if (adj[node][i] == 1 && !visited[i]) {
                    q.push(i);
                    visited[i] = true;
                }
            }
        }
    }

    // Recursive helper for BFS
    void BFSRecursiveHelper(queue<int>& q, vector<bool>& visited) {
        if (q.empty()) return;

        int node = q.front();
        q.pop();
        cout << node << " ";

        for (int i = 0; i < V; i++) {
            // Check for an edge from node to vertex i
            if (adj[node][i] == 1 && !visited[i]) {
                visited[i] = true;
                q.push(i);
            }
        }

        // Recursively call BFS helper
        BFSRecursiveHelper(q, visited);
    }

    // Function to start BFS recursively
    void BFSRecursive(int start) {
        vector<bool> visited(V, false);
        queue<int> q;
        q.push(start);
        visited[start] = true;
        BFSRecursiveHelper(q, visited);
    }
};

int main() {
    // Create a graph with 5 vertices
    Graph g(5);
    g.addEdge(0, 1);
    g.addEdge(0, 2);
    g.addEdge(1, 3);
    g.addEdge(2, 4);

    // Display the adjacency matrix
    g.displayMatrix();
    cout << endl;

    // Perform DFS (Recursive)
    vector<bool> visited(5, false);
    cout << "DFS (Recursive): ";
    g.DFSRecursive(0, visited);
    cout << endl;

    // Perform DFS (Iterative)
    cout << "DFS (Iterative): ";
    g.DFSIterative(0);
    cout << endl;

    // Perform BFS (Iterative)
    cout << "BFS (Iterative): ";
    g.BFSIterative(0);
    cout << endl;

    // Perform BFS (Recursive)
    cout << "BFS (Recursive): ";
    g.BFSRecursive(0);
    cout << endl;

    return 0;
}
